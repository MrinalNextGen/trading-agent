# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored, so your keys never reach GitHub.

# ── Upstox developer app (https://account.upstox.com/developer/apps) ──
UPSTOX_API_KEY=your-api-key
UPSTOX_API_SECRET=your-api-secret
# Must match the redirect URL saved in the Upstox app exactly
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/
# Filled in automatically after you log in (Streamlit "Live market" page or the
# notebook login cell). Upstox tokens expire every day around 3:30 AM IST.
UPSTOX_ACCESS_TOKEN=

# ── Google Sheets live push (optional — pick ONE of the two options) ──
# Option A: service account JSON file (share the sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_NAME=LiveNiftyTrackerSymbol
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet2
# Option B: no JSON file needed — deploy apps_script/LivePush.gs as a web app
# (Extensions → Apps Script in your sheet) and paste the web-app link here.
GOOGLE_SHEETS_WEBAPP_URL=
# Same word as SHARED_TOKEN inside apps_script/LivePush.gs
GOOGLE_SHEETS_WEBAPP_TOKEN=

# ── Backtest defaults (the Streamlit sidebar / CLI flags override these) ──
# Starting money in ₹ (1 lakh)
BACKTEST_CAPITAL=100000
# First year of the test; it always runs up to today
BACKTEST_START_YEAR=2018
# Capital is split into equal chunks between these sizes (₹)
BACKTEST_CHUNK_MIN=5000
BACKTEST_CHUNK_MAX=9000
# Profit-target sweep: 5.0, 5.1, 5.2 … 10.0 %
BACKTEST_TARGET_MIN=5.0
BACKTEST_TARGET_MAX=10.0
BACKTEST_TARGET_STEP=0.1
# Approx. delivery charges: % of trade value per side (STT, stamp, exchange)
BACKTEST_CHARGES_PCT=0.1
# Flat ₹ per sell (DP charge). Set both to 0 to ignore costs.
BACKTEST_CHARGES_FLAT=16
